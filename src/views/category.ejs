
<%- include('partials/header') %>

<main class="categories-page">
    <section class="categories-section">

        <h1><%= category.name %></h1>

        <p class="categories-intro">
            Explore the service projects available in this category.
        </p>

        <div class="category-projects">

            <% if (projects.length > 0) { %>

                <% projects.forEach(project => { %>

                    <article class="category-project-card">

                        <h2>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </h2>

                        <p><%= project.description %></p>

                        <p>
                            <strong>Location:</strong>
                            <%= project.location %>
                        </p>

                        <p>
                            <strong>Project Date:</strong>
                            <%= new Date(project.project_date).toLocaleDateString() %>
                        </p>

                    </article>

                <% }) %>

            <% } else { %>

                <p>No projects are currently assigned to this category.</p>

            <% } %>

        </div>

        <p>
            <a href="/categories">Back to All Categories</a>
        </p>

    </section>
</main>

<%- include('partials/footer') %>

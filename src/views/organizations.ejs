<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p>Here are a few of our partner organizations:</p>

    <div class="organizations">
        <ul>
            <% organizations.forEach(organization => { %>
                <li>
                    <img
                        src="/images/<%= organization.logo_filename %>"
                        alt="<%= organization.name %> logo"
                    >

                    <h2><strong>Organization:</strong> <%= organization.name %></h2>

                    <p><strong>Description:</strong> <%= organization.description %></p>

                    <p class="organization-contact">
                        <strong>Email:</strong>
                        <a href="mailto:<%= organization.contact_email %>">
                            <%= organization.contact_email %>
                        </a>
                    </p>
                </li>
            <% }); %>
        </ul>
    </div>
</main>

<%- include('partials/footer') %>
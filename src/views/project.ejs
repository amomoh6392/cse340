
<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <section class="project-details">
        <h2><%= project.title %></h2>

        <p>
            <strong>Description:</strong>
            <%= project.description %>
        </p>

        <p>
            <strong>Date:</strong>
            <%= new Date(project.date).toLocaleDateString() %>
        </p>

        <p>
            <strong>Location:</strong>
            <%= project.location %>
        </p>

        <p class="project-categories">
            <strong>Categories:</strong>

            <% if (categories.length > 0) { %>

                <% categories.forEach(category => { %>
                    <a href="/category/<%= category.category_id %>" class="category-tag">
                        <%= category.name %>
                    </a>
                <% }) %>

            <% } else { %>

                <span>No categories assigned.</span>

            <% } %>
        </p>
    </section>

    <p class="back-to-projects">
        <a href="/projects">← Back to Upcoming Projects</a>
    </p>
</main>

<%- include('partials/footer') %>

<%- include('partials/header') %>

<main class="container projects-page">

    <section class="projects-intro">
        <h1><%= title %></h1>
        <p>Discover the community projects organized by our partner organizations.</p>
    </section>

    <% if (projects && projects.length > 0) { %>

        <section class="projects-grid">

            <% projects.forEach(project => { %>

                <article class="project-card">

                    <div class="project-card-content">

                        <p class="project-date">
                            <%= new Date(project.date).toLocaleDateString('en-GB', {
                                day: 'numeric',
                                month: 'long',
                                year: 'numeric',
                                timeZone: 'UTC'
                            }) %>
                        </p>

                        <h2>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </h2>

                        <p class="project-description">
                            <%= project.description %>
                        </p>

                        <p class="project-organization">
                            Sponsored by:
                            <strong><a href="/organization/<%= project.organization_id %>">
                                    <%= project.organization_name %>
                                </a></strong>
                        </p>

                        <p class="project-location">
                            <span aria-hidden="true">📍</span>
                            <%= project.location %>
                        </p>

                    </div>

                </article>

            <% }); %>

        </section>

        <% } else { %>

            <p class="no-projects">
                No service projects are currently available.
            </p>

        <% } %>

</main>

<%- include('partials/footer') %>